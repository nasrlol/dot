/* Generated from userChrome.css.tmpl by theme/gen. Do not edit userChrome.css.
   firefox/link puts this chrome/ folder in the profile. Firefox only reads it
   at startup, so restart Firefox after editing or after theme/switch. */

:root {
  --lwt-accent-color: {{bg_alt}} !important;          /* tab strip */
  --lwt-text-color: {{fg}} !important;
  --toolbar-bgcolor: {{bg}} !important;
  --toolbar-color: {{fg}} !important;
  --toolbarbutton-icon-fill: {{fg_dim}} !important;
  --tab-selected-bgcolor: {{surface}} !important;
  --tab-selected-textcolor: {{fg_bright}} !important;

  --toolbar-field-background-color: {{surface}} !important;  /* url bar */
  --toolbar-field-color: {{fg}} !important;
  --toolbar-field-focus-background-color: {{bg_alt}} !important;
  --toolbar-field-focus-color: {{fg_bright}} !important;
  --toolbar-field-focus-border-color: {{accent}} !important;
  --urlbarView-highlight-background: {{selection}} !important;
  --urlbarView-highlight-color: {{fg_bright}} !important;

  --arrowpanel-background: {{bg_alt}} !important;     /* menus and popups */
  --arrowpanel-color: {{fg}} !important;
  --arrowpanel-border-color: {{border}} !important;
  --sidebar-background-color: {{bg}} !important;
  --sidebar-text-color: {{fg}} !important;

  --chrome-content-separator-color: {{border_dim}} !important;
  --focus-outline-color: {{accent}} !important;
}

#navigator-toolbox {
  background-color: var(--lwt-accent-color) !important;
  border-bottom-color: {{border_dim}} !important;
}

/* Selected tab: surface background with an amber underline */
.tab-background:is([selected], [multiselected]) {
  background-color: var(--tab-selected-bgcolor) !important;
  box-shadow: inset 0 -2px {{accent}} !important;
}
.tabbrowser-tab:not([selected]) .tab-label {
  color: {{fg_dim}} !important;
}
