# Generated from config.tmpl by theme/gen. Do not edit config.
# mako starts on demand over D-Bus; theme/switch runs `makoctl reload`.

font=LiterationMono Nerd Font 13
background-color=#111111
text-color=#c4a882
border-color=#3d2b1a
progress-color=over #3a0a00
border-size=2
border-radius=0
padding=12,16
margin=12
width=520
anchor=top-right
layer=overlay
default-timeout=5000
max-visible=4

[urgency=low]
text-color=#8b7355

[urgency=critical]
border-color=#dc4a20
default-timeout=0

# build-notify: one notification per project, replaced on every build
[app-name=build]
group-by=summary

[app-name=build urgency=low]
border-color=#8a8f45

[app-name=build urgency=critical]
border-color=#dc4a20
default-timeout=15000
