# Generated from colors.conf.tmpl by theme/gen. Do not edit colors.conf.
set -g status-style                 bg={{fg}},fg={{fg_dim}}
set -g status-left                  '#{?client_prefix,#[bg={{rust}}#,fg={{bg}}#,bold] PREFIX #[default] ,}#[fg={{bg}},bold]#S#[nobold] - '
# right: pane directory, git branch + CI status (tmux-git-status), clock
set -g status-right                 '#[fg={{bg}}]#{s|^/home/[^/]+|~|;=/-40/…:pane_current_path}#(tmux-git-status "#{pane_current_path}" "fg={{bg}}" "fg={{bg}}" "bg={{rust}},fg={{bg}},bold")#[fg={{bg}}]  %d.%m. %H:%M'
# windows: a rust badge with the exit code when the last command in the
# window's active pane failed (@last_status, set by fish conf.d/tmux.fish)
set -g window-status-format         "#[fg={{bg}}]#I:#W#{?#{&&:#{@last_status},#{!=:#{@last_status},0}}, #[bg={{rust}}#,bold] #{@last_status} #[default],}"
set -g window-status-current-format "#[fg={{bg}},bold](#I:#W#{?window_zoomed_flag, Z,})#{?#{&&:#{@last_status},#{!=:#{@last_status},0}}, #[bg={{rust}}] #{@last_status} #[default],}"
set -g pane-border-style            fg={{border_dim}}
set -g pane-active-border-style     fg={{border}}
set -g mode-style                   bg={{border}},fg={{fg}}
set -g message-style                bg={{rust}},fg={{bg}},bold
set -g message-command-style        bg={{surface}},fg={{accent}}
set -g popup-border-style           fg={{border}}
set -g popup-style                  bg={{bg}}
