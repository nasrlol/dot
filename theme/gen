#!/bin/sh
# Render every *.tmpl in the repo from theme/palette.
#   {{name}}      -> #rrggbb
#   {{name.hex}}  -> rrggbb
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
palette=$root/theme/palette
script=$(mktemp)
trap 'rm -f "$script"' EXIT

grep -E '^[a-z_]+=#[0-9a-fA-F]{6}$' "$palette" | while IFS='=' read -r name value; do
	printf 's/{{%s}}/%s/g\n' "$name" "$value"
	printf 's/{{%s\\.hex}}/%s/g\n' "$name" "${value#\#}"
done > "$script"

find "$root" -name '*.tmpl' -not -path '*/.git/*' | sort | while read -r tmpl; do
	out=${tmpl%.tmpl}
	sed -f "$script" "$tmpl" > "$out.tmp"
	if grep -n '{{[a-z_.]*}}' "$out.tmp" >&2; then
		echo "gen: unknown color in $tmpl" >&2
		rm -f "$out.tmp"
		exit 1
	fi
	[ -x "$tmpl" ] && chmod +x "$out.tmp"
	mv "$out.tmp" "$out"
	echo "${out#"$root"/}"
done
