#!/usr/bin/env bash
# Command palette: one fuzzel list for every action, document and tutorial.
#   actions    ~/.config/palette/actions (label<TAB>command, edit to add more)
#   todo       every todo file under ~/dev, switches waybar's todo module
#   bt / wifi  connect to paired bluetooth devices and visible networks
#   read       PDFs under ~/Documents and ~/school, opened in zathura
#   notes      .md/.txt under ~/Documents and ~/school, opened in emacs
# Bound to Mod+Space in niri.
set -euo pipefail

actions=${XDG_CONFIG_HOME:-$HOME/.config}/palette/actions

# term CMD...: run CMD in a new ghostty window that stays open until enter
term() { printf 'ghostty +new-window -e sh -c %q' "$* ; printf \"\\n[done, enter to close]\"; read _"; }

entries() {
    grep -vE '^\s*(#|$)' "$actions" | while IFS=$'\t' read -r label cmd; do
        [[ $cmd == "term "* ]] && cmd=$(term "${cmd#term }")
        printf '%s\t%s\n' "$label" "$cmd"
    done
    todo=$HOME/.config/waybar/scripts/todo.py
    "$todo" list 2>/dev/null | while IFS=$'\t' read -r name hint path; do
        printf 'todo project  %s  %s\t%q set %q\n' "$name" "$hint" "$todo" "$path"
    done
    bluetoothctl devices Paired 2>/dev/null | while read -r _ mac name; do
        printf 'bt connect %s\tbluetoothctl power on && bluetoothctl connect %s\n' "$name" "$mac"
        printf 'bt disconnect %s\tbluetoothctl disconnect %s\n' "$name" "$mac"
    done
    # cached scan results (fast); "wifi rescan" refreshes them. --ask prompts
    # for a password in a terminal when the network isn't known yet
    nmcli -t -f SSID dev wifi list --rescan no 2>/dev/null | grep -v '^$' | sort -u |
        while read -r ssid; do
            printf 'wifi connect %s\t%s\n' "$ssid" "$(term "nmcli --ask dev wifi connect $(printf %q "$ssid")")"
        done
    find "$HOME/Documents" "$HOME/school" -type f -name '*.pdf' 2>/dev/null | sort |
        while read -r f; do printf 'read  %s\tzathura %q\n' "${f#"$HOME"/}" "$f"; done
    find "$HOME/Documents" "$HOME/school" -type f \( -name '*.md' -o -name '*.txt' \) 2>/dev/null | sort |
        while read -r f; do printf 'notes %s\temacsclient -c -a %q %q\n' "${f#"$HOME"/}" '' "$f"; done
}

cmd=$(entries | fuzzel --dmenu --with-nth=1 --accept-nth=2 --placeholder="action, document or note") || exit 0
[ -n "$cmd" ] || exit 0
setsid -f bash -c "$cmd" >/dev/null 2>&1 </dev/null
