#!/bin/sh
# Pick a frecent directory from zoxide and open it as a new window in the
# current session. (Sessions per directory live in tmux-session-switcher.)
set -eu
dir=$(zoxide query -l | fzf --prompt='dir> ' --preview='ls -A {}') || exit 0
tmux new-window -n "$(basename "$dir" | tr '.:' '__')" -c "$dir"
