# Generated from colors.tmpl by theme/gen. Do not edit colors.
set default-bg                "{{bg}}"
set default-fg                "{{fg}}"
set statusbar-bg              "{{bg_alt}}"
set statusbar-fg              "{{fg_dim}}"
set inputbar-bg               "{{bg_alt}}"
set inputbar-fg               "{{fg_bright}}"
set notification-bg           "{{bg_alt}}"
set notification-fg           "{{fg}}"
set notification-error-bg     "{{bg_alt}}"
set notification-error-fg     "{{rust_bright}}"
set notification-warning-bg   "{{bg_alt}}"
set notification-warning-fg   "{{accent_bright}}"
set completion-bg             "{{surface}}"
set completion-fg             "{{fg}}"
set completion-group-bg       "{{bg_alt}}"
set completion-group-fg       "{{comment}}"
set completion-highlight-bg   "{{selection}}"
set completion-highlight-fg   "{{fg_bright}}"
set index-bg                  "{{bg}}"
set index-fg                  "{{fg}}"
set index-active-bg           "{{selection}}"
set index-active-fg           "{{fg_bright}}"
set highlight-color           "{{accent}}"
set highlight-active-color    "{{accent_bright}}"
set highlight-fg              "{{bg}}"

# Page colors when recoloring (Ctrl+R): text in fg on the page background.
set recolor-lightcolor        "{{bg}}"
set recolor-darkcolor         "{{fg}}"
