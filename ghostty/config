# Ghostty Configuration
# Modern, animated terminal setup inspired by Alacritty
# Place at: ~/.config/ghostty/config
# Reload: Cmd+Shift+, (macOS) or Ctrl+Shift+, (Linux)

# ============================================================================
# WINDOW & DISPLAY
# ============================================================================

window-decoration = auto
maximize = false
fullscreen = false

# Window size (cells)
window-width = 200
window-height = 60

# Dynamic padding that adapts to window
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-padding-color = background

# Tab bar with smooth animations
window-show-tab-bar = auto
window-new-tab-position = current

# Titlebar
title = Ghostty
class = com.mitchellh.ghostty
x11-instance-name = ghostty

# Smooth rendering
window-vsync = true

# ============================================================================
# FONT & TEXT RENDERING
# ============================================================================

# Comic Mono - fun, readable, handmade feel
font-family = ComicMono
font-family-bold = ComicMono
font-family-italic = ComicMono
font-family-bold-italic = ComicMono
font-size = 11

# Font features (disable ligatures for that raw feel)
font-feature = -calt,-liga,-dlig

# Smooth rendering with proper color space blending
alpha-blending = linear-corrected
freetype-load-flags = hinting,light

# Font baseline/offset tuning (like Alacritty's offset)
adjust-font-baseline = 1
adjust-cell-height = 0
adjust-cell-width = 0

# Font shaping - break under cursor for better selection
font-shaping-break = cursor

# Grapheme width for proper emoji/unicode handling
grapheme-width-method = unicode

# ============================================================================
# CURSOR
# ============================================================================

# Block cursor, never blink (like vi)
cursor-style = block
cursor-style-blink = false
cursor-opacity = 1

# Colors
cursor-color = #FFD700
cursor-text = #072626

# Unfocused cursor becomes hollow
# (Ghostty shows this via opacity changes)
cursor-click-to-move = false

# ============================================================================
# COLORS & THEMING
# ============================================================================

# Primary colors - warm dark theme
background = #072626
foreground = #A08563

# Cursor colors with animation feel
# (Ghostty will smoothly transition between cursor states)
selection-foreground = #A08563
selection-background = #0A3B3B

# Minimum contrast for readability
minimum-contrast = 1.1

# Search highlighting (for scrollback search feature)
search-foreground = #072626
search-background = #FFD700
search-selected-foreground = #072626
search-selected-background = #FF4500

# ============================================================================
# TERMINAL BEHAVIOR
# ============================================================================

# Shell
command = /usr/bin/zsh

# Working directory
working-directory = home
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

# Scrollback with history
scroll-to-bottom = keystroke,no-output

# Scrollbar visibility (auto/never/always)
scrollbar = system

# ============================================================================
# MOUSE & INTERACTION
# ============================================================================

# Hide mouse when typing (smooth fade)
mouse-hide-while-typing = true

# Mouse wheel scrolling
mouse-scroll-multiplier = 3

# Mouse selection behavior
mouse-reporting = true
mouse-shift-capture = false

# Selection word boundaries
selection-word-chars = " \t'\"│`|:;,()[]{}<>$"
selection-clear-on-typing = true
selection-clear-on-copy = false

# Auto-copy selection
copy-on-select = true

# Right-click behavior
right-click-action = context-menu

# Click repeat timing
click-repeat-interval = 0

# ============================================================================
# SPLITS & LAYOUT
# ============================================================================

# Unfocused split dimming (smooth fade effect)
unfocused-split-opacity = 0.85
unfocused-split-fill = #000000

# Split divider styling
split-divider-color = #0A3B3B

# Focus behavior
focus-follows-mouse = false

# Preserve zoom state when navigating
split-preserve-zoom = navigation

# ============================================================================
# CLIPBOARD & LINKING
# ============================================================================

# Clipboard permissions
clipboard-read = ask
clipboard-write = allow
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true

# URL handling
link-url = true
link-previews = true

# ============================================================================
# VISUAL EFFECTS & ANIMATIONS
# ============================================================================

# Background opacity with smooth transitions
background-opacity = 1.0
background-opacity-cells = false

# Disable blur for clean, fast rendering
# (or enable with: background-blur = true on supported systems)
background-blur = false

# Resize overlay with animation
resize-overlay = after-first
resize-overlay-position = center
resize-overlay-duration = 750ms

# Cursor animations
adjust-cursor-thickness = 0
adjust-cursor-height = 0

# ============================================================================
# ADVANCED RENDERING
# ============================================================================

# Cell metrics - match Alacritty feel
adjust-cell-width = 0
adjust-cell-height = 0

# Underline styling
adjust-underline-position = 0
adjust-underline-thickness = 1

# Strikethrough styling
adjust-strikethrough-position = 0
adjust-strikethrough-thickness = 1

# Box drawing characters
adjust-box-thickness = 0

# Icon sizing (for nerd fonts)
adjust-icon-height = 0

# Font synthetic styles
font-synthetic-style = true

# ============================================================================
# BEHAVIOR
# ============================================================================

# Title handling
title-report = false

# Close confirmation
confirm-close-surface = true

# Quit behavior
quit-after-last-window-closed = false

# Shell integration (detect mode)
# shell-integration = detect

# Undo timeout (macOS only)
undo-timeout = 5s

# ============================================================================
# PLATFORM: macOS SPECIFIC
# ============================================================================

# macOS titlebar styling
# macos-titlebar-style = tabs | transparent | hidden | system

# Vertical sync for smooth animations
window-vsync = true

# Use macOS color space
window-colorspace = srgb


# ============================================================================
# OPTIONAL: BACKGROUND IMAGE
# ============================================================================

# Uncomment to use background image
# background-image = /path/to/image.png
# background-image-opacity = 0.1
# background-image-position = center
# background-image-fit = cover
# background-image-repeat = false

# ============================================================================
# OPTIONAL: PLATFORM-SPECIFIC CONFIGS
# ============================================================================

# Load machine-specific or work-specific configs
# config-file = ?~/.config/ghostty/work.config
# config-file = ?~/.config/ghostty/personal.config
