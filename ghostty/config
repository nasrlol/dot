 # ==========================================
# 1. VISUALS & THEME (High Contrast Mono)
# ==========================================
background = #000000
foreground = #ffffff
selection-background = #ffffff
selection-foreground = #000000
cursor-color = #ffffff

# Translucency for that modern feel
background-opacity = 0.95
background-blur-radius = 20

# ==========================================
# 2. ADVANCED TYPOGRAPHY
# ==========================================
font-family = "JetBrains Mono"
font-size = 18
# Makes text thicker for higher contrast on dark backgrounds
font-thicken = true
# Cell height provides "breathing room" (percentage or absolute)
adjust-cell-height = 20%
# Disable specific ligatures for raw performance if desired
font-feature = -liga, -calt

# [CHANGE] Reset to 0 for standard cursor size (was 15)
adjust-cursor-height = 1

# ==========================================
# 3. ANIMATIONS & CURSOR
# ==========================================
cursor-style = block
cursor-style-blink = true
# Smooth cursor movement across cells

# ==========================================
# 4. MOUSE & INTERACTION
# ==========================================
mouse-hide-while-typing = true
mouse-scroll-multiplier = 2
# Copy to clipboard immediately upon selecting text
copy-on-select = clipboard
# Clear selection when you start typing
selection-clear-on-typing = true

# ==========================================
# 5. WINDOW & OS INTEGRATION
# ==========================================
window-decoration = false
# Balances padding equally on all sides
window-padding-balance = true
window-padding-x = 12
window-padding-y = 12
# For Linux/macOS: save window position/size across restarts
window-save-state = always

# ==========================================
# 6. SHELL & COMMANDS
# ==========================================
# Enhanced shell features (sudo detection, title control)
shell-integration = detect
shell-integration-features = sudo,no-cursor,no-title
# Show URL previews when hovering with Cmd/Ctrl
link-previews = true
