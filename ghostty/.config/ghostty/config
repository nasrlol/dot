alpha-blending = linear-corrected
auto-update-channel = "tip"
# The shader only moves while the cursor does; "true" stops redrawing
# unfocused windows (saves battery), and the unfocused cursor is static anyway.
custom-shader-animation = true
desktop-notifications = true
mouse-hide-while-typing = true
# no-cursor: shader/cursor.glsl draws the cursor. ssh-*: copy terminfo to
# remote hosts and fall back to a known TERM, so ssh doesn't break.
shell-integration-features = no-cursor,sudo,title,ssh-terminfo,ssh-env

# Keep one resident process (started by niri spawn-at-startup) so new
# windows skip GTK/OpenGL init.
gtk-single-instance = true
quit-after-last-window-closed = false
unfocused-split-fill = "#000000"

# Tiled by niri: no size popup on every column resize.
resize-overlay = never
# Padding takes the colour of the nearest row, so tmux's top status bar runs
# edge to edge like 4coder's file bar (paired with the small top padding below).
window-padding-color = extend

# Colors from theme/palette (same as foot), no decorations. 20px padding
# except 6px on top: with padding-color = extend that 6px becomes part of the
# tmux status bar, giving it 4coder-style breathing room above the text.
# Balance is off so leftover space goes to the bottom instead of making the
# bar's height vary with window size.
config-file = colors
window-padding-x = 20
window-padding-y = 6,20
window-padding-balance = false
window-decoration = false
gtk-titlebar = false
cursor-style = block
cursor-style-blink = false
# Drawn by shader/cursor.glsl as a small rounded block instead.
cursor-opacity = 0

# Close windows, tabs and splits without asking, even with a process running.
confirm-close-surface = false

# niri owns super+…, so Ghostty's super bindings never fire. Ghostty's
# defaults already cover the rest: ctrl+= / ctrl+- font size, ctrl+shift+,
# reload, ctrl+alt+arrows splits, ctrl+shift+left/right tabs,
# ctrl+shift+page_up/down prompts. Add arrow versions of the prompt jump
# (no page keys on the MacBook without fn).
keybind = ctrl+shift+up=jump_to_prompt:-1
keybind = ctrl+shift+down=jump_to_prompt:1

# Swappable snippets, switched with the fish `gconf` function
# (fish/.config/fish/functions/gconf.fish). Later lines win, so order matters:
#   font/*     family, size and per-font cell/underline tweaks
#   leading/*  overrides the font's adjust-cell-height
#   host.conf  last, overrides any of the above for this machine
#              (hosts/asahi.conf currently pins its own font and leading)
adjust-underline-position = 8
adjust-underline-thickness = 2
config-file = font/liberation-mono
config-file = leading/7
config-file = opacity/100%
custom-shader = shader/cursor.glsl
config-file = thicken/on
config-file = oldstyle/off
# Per-host overrides (hosts/<host>.conf, linked as host.conf by ./install)
config-file = ?host.conf

