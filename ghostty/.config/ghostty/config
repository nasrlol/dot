adjust-underline-position = 8
adjust-underline-thickness = 2
alpha-blending = linear-corrected
auto-update-channel = "tip"
custom-shader-animation = "always"
desktop-notifications = true
mouse-hide-while-typing = "true"
shell-integration-features = no-cursor

# Keep one resident process (started by niri spawn-at-startup) so new
# windows skip GTK/OpenGL init.
gtk-single-instance = true
quit-after-last-window-closed = false
unfocused-split-fill = "#000000"

# Match foot (foot/.config/foot/foot.ini): colors from theme/palette, 20px
# padding centered like center-when-maximized-and-fullscreen, blinking block
# cursor, no decorations.
config-file = colors
window-padding-x = 20
window-padding-y = 20
window-padding-balance = true
window-decoration = false
gtk-titlebar = false
cursor-style = block
cursor-style-blink = true

keybind = super++=unbind
keybind = super+equal=unbind
keybind = super+bracket_left=unbind
keybind = super+shift+bracket_left=unbind
keybind = super+bracket_right=unbind
keybind = super+shift+bracket_right=unbind


# Ghostty bindings defined to characters such a "=", "[", and "]" map to the
# intended key in the current input layout. For example, when the layout is
# dvorak, "[" maps to the physical key labeled as "-". This gives us bindings
# that work in dvorak.
keybind = super+==increase_font_size:1
keybind = super+[=goto_split:previous
keybind = super+shift+[=previous_tab
keybind = super+]=goto_split:next
keybind = super+shift+]=next_tab

# Jump between shell prompts
keybind = super+shift+up=jump_to_prompt:-1
keybind = super+shift+down=jump_to_prompt:1

