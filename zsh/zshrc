edit() {
    local file
    if ! git rev-parse --git-dir >/dev/null 2>&1; then
        file=$(fzf --preview 'bat --style=full --color=always {} 2>/dev/null' \
                   --preview-window=right:60%:wrap)
    else
        file=$(git ls-files | fzf --preview 'bat -n --style=full --color=always {} 2>/dev/null' \
                                   --preview-window=right:60%:wrap)
    fi
    [[ -n "$file" ]] && nvim "$file"
}

config() {
    local file
    file=$(git -C ~/.config ls-files | fzf \
        --preview 'bat -n --style=full --color=always ~/.config/{} 2>/dev/null' \
        --preview-window=right:60%:wrap)
    [[ -n "$file" ]] && nvim ~/.config/"$file"
}

goto() {
    local file
    file=$(fd --type f --hidden --follow \
        --exclude .git \
        --exclude node_modules \
        --exclude target \
        --exclude build \
        . ~ \
        | fzf --preview 'bat -n --style=full --color=always {} 2>/dev/null' \
              --preview-window=right:60%:wrap)
    [[ -n "$file" ]] && cd "$(dirname "$file")"
}

groot() {
    local root
    root=$(git rev-parse --show-toplevel 2>/dev/null)
    if [[ -n "$root" ]]; then
        cd "$root"
    else
        echo "Not in a git repository"
        return 1
    fi
}

mkcd() {
    mkdir -p "$1" && cd "$1"
}

extract() {
    if [[ -f "$1" ]]; then
        case "$1" in
            *.tar.bz2)   tar xjf "$1"     ;;
            *.tar.gz)    tar xzf "$1"     ;;
            *.bz2)       bunzip2 "$1"     ;;
            *.rar)       unrar x "$1"     ;;
            *.gz)        gunzip "$1"      ;;
            *.tar)       tar xf "$1"      ;;
            *.tbz2)      tar xjf "$1"     ;;
            *.tgz)       tar xzf "$1"     ;;
            *.zip)       unzip "$1"       ;;
            *.Z)         uncompress "$1"  ;;
            *.7z)        7z x "$1"        ;;
            *)           echo "'$1' cannot be extracted via extract()" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

gcm() {
    git commit -m "$*"
}

gac() {
    git add .
    git commit -m "$*"
}

gnb() {
    git checkout -b "$1"
}

psg() {
    ps aux | grep -v grep | grep -i -e VSZ -e "$1"
}

killp() {
    local pid
    pid=$(psg "$1" | awk '{print $2}')
    if [[ -n "$pid" ]]; then
        echo "Killing process $pid"
        kill -9 $pid
    else
        echo "No process found matching: $1"
    fi
}

backup() {
    local filename=$(basename "$1")
    local timestamp=$(date +%Y%m%d_%H%M%S)
    cp -r "$1" "$1.backup_$timestamp"
    echo "Backed up to: $1.backup_$timestamp"
}

note() {
    local note_file=~/notes/$(date +%Y-%m-%d).md
    if [[ ! -e "$note_file" ]]; then
        echo "# Notes for $(date +%Y-%m-%d)" > "$note_file"
        echo "" >> "$note_file"
    fi
    echo "- [$(date +%H:%M)] $*" >> "$note_file"
    echo "Note added to $note_file"
}

