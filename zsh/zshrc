# Extract archives
extract() {
    if [[ -f "$1" ]]; then
        case "$1" in
            *.tar.bz2|*.tbz2)   tar xjf "$1"     ;;
            *.tar.gz|*.tgz)     tar xzf "$1"     ;;
            *.bz2)              bunzip2 "$1"     ;;
            *.rar)              unrar x "$1"     ;;
            *.gz)               gunzip "$1"      ;;
            *.tar)              tar xf "$1"      ;;
            *.zip)              unzip "$1"       ;;
            *.Z)                uncompress "$1"  ;;
            *.7z)               7z x "$1"        ;;
            *)                  echo "'$1' cannot be extracted via extract()" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

# Process utilities
psg() {
    ps aux | grep -v grep | grep -i -e VSZ -e "$1"
}

killp() {
    local pid
    pid=$(psg "$1" | awk '{print $2}')
    if [[ -n "$pid" ]]; then
        echo "Killing process $pid"
        kill -9 $pid
    else
        echo "No process found matching: $1"
    fi
}

# Utilities
backup() {
    local filename=$(basename "$1")
    local timestamp=$(date +%Y%m%d_%H%M%S)
    cp -r "$1" "$1.backup_$timestamp"
    echo "Backed up to: $1.backup_$timestamp"
}

note() {
    local note_file=~/notes/$(date +%Y-%m-%d).md
    if [[ ! -e "$note_file" ]]; then
        echo "# Notes for $(date +%Y-%m-%d)" > "$note_file"
        echo "" >> "$note_file"
    fi
    echo "- [$(date +%H:%M)] $*" >> "$note_file"
    echo "Note added to $note_file"
}

