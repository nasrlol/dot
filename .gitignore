emacs/.config/emacs/tramp
emacs/.config/emacs/projects
emacs/.config/emacs/semanticdb/
emacs/.config/emacs/ede-projects.el
tmux/.config/tmux/plugins/
lazygit/.config/lazygit/state.yml

# Per-machine overrides, never committed
**/local.fish
**/local.kdl
git/.config/git/local
.host
**/host.kdl
**/host.json
**/host.css
**/host.ini
**/host.toml
