# Per-machine hosts go in ~/.ssh/config.d/*.conf (not committed).
Include config.d/*.conf

Host github.com
    User git
    IdentityFile ~/.ssh/id_ed25519

Host *
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519
    # Reuse one connection per host: second ssh/git op is instant
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m
    ServerAliveInterval 60
    ServerAliveCountMax 3
    HashKnownHosts yes
    UpdateHostKeys yes
