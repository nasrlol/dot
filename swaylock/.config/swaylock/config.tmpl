# Generated from config.tmpl by theme/gen. Do not edit config.
# Run ./lock rather than swaylock directly: it draws the background image and
# adds the clock options when swaylock-effects is installed. Everything here
# also works with plain swaylock.
color={{bg.hex}}
scaling=fill
daemonize
show-failed-attempts
ignore-empty-password
indicator-caps-lock
indicator-radius=120
indicator-thickness=6
font=Iosevka

inside-color=00000000
inside-clear-color=00000000
inside-ver-color=00000000
inside-wrong-color=00000000
line-color=00000000
separator-color=00000000
ring-color={{border.hex}}
ring-clear-color={{accent_bright.hex}}
ring-ver-color={{accent.hex}}
ring-wrong-color={{rust_bright.hex}}
key-hl-color={{accent.hex}}
bs-hl-color={{rust.hex}}
text-color={{fg_bright.hex}}
text-clear-color={{fg_bright.hex}}
text-ver-color={{fg_bright.hex}}
text-wrong-color={{rust_bright.hex}}
