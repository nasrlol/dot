# ~/.config/wofi/config

# === Geometry ===
# Percentages of the output so it fits any monitor; font and padding sizes
# are per host in hosts/<host>.css.
width=35%
height=25%
columns=1

# center, top_left, top, top_right, right, bottom_right, bottom, bottom_left, left.
# top is already horizontally centered, and unlike center it doesn't jump
# around as dynamic_lines shrinks it. No inline comments in this file: wofi
# keeps them as part of the value.
location=top
# px down from top edge
yoffset=200
# background, bottom, top, overlay
layer=overlay
# use global compositor space for x/y (avoid with location=)
global_coords=false
# set true if not using wlroots/layer-shell
normal_window=false

# run, drun, dmenu, or combi e.g. run,drun
show=drun
# fork so the launching terminal can close
fork=true

prompt=
# contains, strict-contains, multi-contains, fuzzy
matching=fuzzy
insensitive=true
# debounce ms - faster filtering
filter_rate=1
# true makes Enter run the typed text instead of the first result
exec_search=false
# strip pango/image escapes from search
parse_search=false
# disable multi-action entries
no_actions=false

# alphabetical sorting is faster than default
sort_order=alphabetical
# icon size in px
image_size=0
# grow window to fit results
dynamic_lines=true
# off, word, char, word_char
line_wrap=word
# allow pango markup in entries
allow_markup=false
# don't show all entries initially - faster startup
show_all=false
allow_images=false

hide_search=false
hide_scroll=true
term_string=foot

copy_exec=wl-copy

quit_on_focus_loss=false

# === Password mode (uncomment to enable) ===
# password_char=*

# === Custom key bindings ===
key_expand=Tab
key_exit=Escape,Ctrl-bracketleft
key_up=Up,Ctrl-k
key_down=Down,Ctrl-j
key_pgup=Page_Up,Ctrl-u
key_pgdn=Page_Down,Ctrl-d
# key_custom_0=Ctrl-1     # exit code 10
# key_custom_1=Ctrl-2     # exit code 11
# key_custom_2=Ctrl-3     # exit code 12

# === drun mode options ===
# print desktop file path instead of launching
drun-print_command=false
# show generic app name alongside app name
drun-display_generic=true
# search only app name, skip category/description
drun-only_match_name=false
drun-ignore_non_default_gpu=false

# === run mode options ===
run-cache_file=~/.cache/wofi-run
run-always_parse_args=false
run-show_all=true

# === dmenu mode options ===
dmenu-parse_action=false
dmenu-separator=
dmenu-print_line_num=false
