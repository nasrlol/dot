{
  "layer": "top",
  "position": "bottom",
  "height": 44,
  "spacing": 0,
  "margin-top": 0,
  "margin-right": 8,
  "margin-bottom": 6,
  "margin-left": 8,

  "modules-left": [
    "custom/workspaces",
    "custom/window"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "custom/volume",
    "custom/network",
    "cpu",
    "memory"
  ],

  "custom/workspaces": {
    "exec": "~/.config/waybar/scripts/niri-workspaces.py",
    "return-type": "json",
    "escape": false
  },

  "custom/window": {
    "exec": "~/.config/waybar/scripts/niri-window.py",
    "return-type": "json"
  },

  "clock": {
    "timezone": "Europe/Brussels",
    "format": " {:%H:%M}",
    "format-alt": " {:%A, %B %d, %Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#C4A882'><b>{}</b></span>",
        "days": "<span color='#D9C6A5'>{}</span>",
        "weeks": "<span color='#8B7355'><b>W{}</b></span>",
        "weekdays": "<span color='#D48B30'><b>{}</b></span>",
        "today": "<span color='#C84820'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode"
    },
    "interval": 60
  },

  "custom/volume": {
    "exec": "~/.config/waybar/scripts/volume.py",
    "return-type": "json",
    "interval": 2,
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol-qt",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
  },

  "custom/network": {
    "exec": "~/.config/waybar/scripts/network.py",
    "return-type": "json",
    "interval": 5
  },

  "cpu": {
    "format": " {usage}%",
    "interval": 5
  },

  "memory": {
    "format": " {percentage}%",
    "interval": 5
  }
}
