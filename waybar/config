{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,

    // 1. Module Placement
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/submap"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "network",
        "battery",
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "active-only": false,
        "format": "{name}"
    },

    "clock": {
        "timezone": "Europe/Brussels",
        "format": "{:%H:%M || %Y-%m-%d}",
        "tooltip-format": "<big>{:%Y}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "format": "CPU: {usage}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "RAM: {}%",
        "interval": 2
    },

    "network": {
        "format-wifi": "  {essid}  " ,
        "format-ethernet": "eth",
        "format-disconnected": "dscon",
        "tooltip-format": "{ifname} via {gwaddr}"
    },

    "pulseaudio": {
        "format": "VOL: {volume}%",
        "format-muted": "MUTED",
        "on-click": "pavucontrol"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "BAT: {capacity}%",
        "format-charging": "CHG: {capacity}%",
        "interval": 5
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    }
}
