// Bars only: which modules go where, per output. Every module is defined once
// in modules.jsonc (generated from modules.jsonc.tmpl by theme/gen, because
// the clock's calendar uses palette colours) and pulled in with "include".
//
// The top bars are laid out from fixed pixel slots (see style.css), so no
// module's text length can move another module, and on the laptop the notch
// spacer is the centre widget, so it sits exactly over the notch. spacing is 0 on every bar: all
// gaps live in style.css, where the slot arithmetic is.
[
  {
    // Laptop panel: 2560px wide with the notch in the middle
    "name": "top",
    "output": "eDP-1",
    "include": "~/.config/waybar/modules.jsonc",
    "layer": "top",
    "position": "top",
    "height": 55,
    "spacing": 0,
    // Let the left group fill up to the centre, so todo ("expand") can grow to it
    "expand-left": true,
    "modules-left": ["niri/workspaces", "custom/build", "custom/todo"],
    "modules-center": ["custom/notch"],
    "modules-right": ["custom/media", "niri/window", "clock"]
  },
  {
    // Every other monitor: same modules; the "notch" is just a small gap there
    "name": "top-external",
    "output": ["!eDP-1", "*"],
    "include": "~/.config/waybar/modules.jsonc",
    "layer": "top",
    "position": "top",
    "height": 55,
    "spacing": 0,
    // Let the left group fill up to the centre, so todo ("expand") can grow to it
    "expand-left": true,
    "modules-left": ["niri/workspaces", "custom/build", "custom/todo"],
    "modules-center": ["custom/notch"],
    "modules-right": ["custom/media", "niri/window", "clock"]
  },
  {
    "name": "bottom",
    "include": "~/.config/waybar/modules.jsonc",
    "layer": "top",
    "position": "bottom",
    "height": 42,
    "spacing": 0,
    "modules-left": ["cpu", "memory", "custom/temperature", "disk", "custom/contributions"],
    // Only visible while emerge runs; alone in the centre, so its width moves nothing
    "modules-center": ["custom/emerge"],
    "modules-right": ["custom/volume", "custom/network", "custom/tailscale", "bluetooth", "custom/power", "custom/battery"]
  }
]
