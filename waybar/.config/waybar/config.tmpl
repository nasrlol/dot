[
  {
    "name": "top",
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 10,
    "margin-top": 8,
    "margin-right": 16,
    "margin-bottom": 6,
    "margin-left": 16,
    "modules-left": [
      "niri/workspaces"
    ],
    "modules-right": [
      "custom/media",
      "custom/todo",
      "custom/window"
    ],
    "niri/workspaces": {
      "all-outputs": true,
      "format": "{value}"
    },
    "custom/media": {
      "exec": "~/.config/waybar/scripts/media.py",
      "return-type": "json",
      "on-click": "playerctl play-pause",
      "on-scroll-up": "playerctl next",
      "on-scroll-down": "playerctl previous"
    },
    "custom/todo": {
      "exec": "~/.config/waybar/scripts/todo.py",
      "return-type": "json",
      "interval": 5,
      "on-click": "emacsclient -c -a '' ~/todo.txt"
    },
    "custom/window": {
      "exec": "~/.config/waybar/scripts/niri-window.py",
      "return-type": "json"
    }
  },
  {
    "name": "bottom",
    "layer": "top",
    "position": "bottom",
    "height": 40,
    "margin-top": 6,
    "margin-bottom": 8,
    "modules-center": [
      "custom/theme",
      "clock",
      "idle_inhibitor"
    ],
    "custom/theme": {
      "exec": "~/.config/waybar/scripts/theme.sh",
      "return-type": "json",
      "format": "{icon}",
      "format-icons": {
        "dark": "dark",
        "light": "light"
      },
      "on-click": "~/dotfiles/theme/switch"
    },
    "clock": {
      "timezone": "Europe/Brussels",
      "format": "{:%H:%M}",
      "format-alt": "{:%A, %B %d, %Y}",
      "tooltip-format": "<tt><small>{calendar}</small></tt>",
      "calendar": {
        "mode": "month",
        "mode-mon-col": 3,
        "weeks-pos": "right",
        "on-scroll": 1,
        "format": {
          "months": "<span color='{{fg}}'><b>{}</b></span>",
          "days": "<span color='{{fg_bright}}'>{}</span>",
          "weeks": "<span color='{{fg_dim}}'><b>W{}</b></span>",
          "weekdays": "<span color='{{accent}}'><b>{}</b></span>",
          "today": "<span color='{{rust}}'><b><u>{}</u></b></span>"
        }
      },
      "actions": {
        "on-click-right": "mode"
      },
      "interval": 60
    },
    "modules-left": [
      "battery"
    ],
    "modules-right": [
      "custom/volume",
      "backlight",
      "custom/network",
      "bluetooth"
    ],
    "backlight": {
      "device": "apple-panel-bl",
      "format": "bri {percent}%",
      "scroll-step": 5
    },
    "bluetooth": {
      "format": "bt on",
      "format-disabled": "bt off",
      "format-off": "bt off",
      "format-connected": "bt {num_connections}",
      "tooltip-format": "{controller_alias}\t{controller_address}",
      "tooltip-format-connected": "{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}",
      "on-click": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on"
    },
    "idle_inhibitor": {
      "format": "{icon}",
      "format-icons": {
        "activated": "awake",
        "deactivated": "idle"
      },
      "tooltip-format-activated": "Idle inhibitor on",
      "tooltip-format-deactivated": "Idle inhibitor off"
    },
    "spacing": 0,
    "margin-left": 16,
    "margin-right": 16,
    "custom/volume": {
      "exec": "~/.config/waybar/scripts/volume.py",
      "return-type": "json",
      "on-click": "~/.config/waybar/scripts/volume.py mute",
      "on-click-right": "pavucontrol-qt",
      "on-scroll-up": "~/.config/waybar/scripts/volume.py up",
      "on-scroll-down": "~/.config/waybar/scripts/volume.py down"
    },
    "custom/network": {
      "exec": "~/.config/waybar/scripts/network.py",
      "return-type": "json"
    },
    "battery": {
      "interval": 30,
      "states": {
        "warning": 25,
        "critical": 10
      },
      "format": "bat {capacity}%",
      "format-charging": "chg {capacity}%",
      "format-plugged": "ac {capacity}%",
      "tooltip-format": "{timeTo}"
    }
  }
]
