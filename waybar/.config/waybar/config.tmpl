[
  {
    "layer": "top",
    "position": "top",
    // height comes from host.json (hosts/<host>.json)
    "include": ["~/.config/waybar/host.json"],
    "spacing": 10,
    "margin-top": 8,
    "margin-right": 8,
    "margin-bottom": 6,
    "margin-left": 12,
    "modules-left": [
      "custom/workspaces",
      "custom/window"
    ],
    "modules-right": [
      "custom/volume",
      "custom/network",
      "battery"
    ],
    "custom/workspaces": {
      "exec": "~/.config/waybar/scripts/niri-workspaces.py",
      "return-type": "json",
      "escape": false
    },
    "custom/window": {
      "exec": "~/.config/waybar/scripts/niri-window.py",
      "return-type": "json"
    },
    "custom/volume": {
      "exec": "~/.config/waybar/scripts/volume.py",
      "return-type": "json",
      "on-click": "~/.config/waybar/scripts/volume.py mute",
      "on-click-right": "pavucontrol-qt",
      "on-scroll-up": "~/.config/waybar/scripts/volume.py up",
      "on-scroll-down": "~/.config/waybar/scripts/volume.py down"
    },
    "custom/network": {
      "exec": "~/.config/waybar/scripts/network.py",
      "return-type": "json"
    },
    "battery": {
      "interval": 30,
      "states": {
        "warning": 25,
        "critical": 10
      },
      "format": "bat {capacity}%",
      "format-charging": "chg {capacity}%",
      "format-plugged": "ac {capacity}%",
      "tooltip-format": "{timeTo}"
    }
  },
  {
    "name": "bottom",
    // height and modules-right come from host.json (hosts/<host>.json)
    "include": ["~/.config/waybar/host.json"],
    "layer": "top",
    "position": "bottom",
    "margin-top": 6,
    "margin-bottom": 8,
    "modules-center": [
      "clock"
    ],
    "clock": {
      "timezone": "Europe/Brussels",
      "format": "{:%H:%M}",
      "format-alt": "{:%A, %B %d, %Y}",
      "tooltip-format": "<tt><small>{calendar}</small></tt>",
      "calendar": {
        "mode": "month",
        "mode-mon-col": 3,
        "weeks-pos": "right",
        "on-scroll": 1,
        "format": {
          "months": "<span color='{{fg}}'><b>{}</b></span>",
          "days": "<span color='{{fg_bright}}'>{}</span>",
          "weeks": "<span color='{{fg_dim}}'><b>W{}</b></span>",
          "weekdays": "<span color='{{accent}}'><b>{}</b></span>",
          "today": "<span color='{{rust}}'><b><u>{}</u></b></span>"
        }
      },
      "actions": {
        "on-click-right": "mode"
      },
      "interval": 60
    },
    "modules-left": [
      "cpu",
      "memory",
      "temperature"
    ],
    "cpu": {
      "format": "cpu {usage}%",
      "interval": 5
    },
    "memory": {
      "format": "mem {percentage}%",
      "interval": 5
    },
    "temperature": {
      "critical-threshold": 80,
      "format": "temp {temperatureC}°C",
      "interval": 5
    },
    "backlight": {
      "format": "bri {percent}%",
      "scroll-step": 5
    },
    "bluetooth": {
      "format": "bt on",
      "format-disabled": "bt off",
      "format-off": "bt off",
      "format-connected": "bt {num_connections}",
      "tooltip-format": "{controller_alias}\t{controller_address}",
      "tooltip-format-connected": "{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}",
      "on-click": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on"
    },
    "idle_inhibitor": {
      "format": "{icon}",
      "format-icons": {
        "activated": "awake",
        "deactivated": "idle"
      },
      "tooltip-format-activated": "Idle inhibitor on",
      "tooltip-format-deactivated": "Idle inhibitor off"
    },
    "spacing": 10,
    "margin-left": 12,
    "margin-right": 8
  }
]
