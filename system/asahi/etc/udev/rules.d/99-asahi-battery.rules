# Apple Silicon (Asahi): stop charging at 80% to reduce battery wear.
# The SMC resumes charging at 75%. Set to 100 before a trip:
#   echo 100 | sudo tee /sys/class/power_supply/macsmc-battery/charge_control_end_threshold
SUBSYSTEM=="power_supply", KERNEL=="macsmc-battery", ATTR{charge_control_end_threshold}="80"
