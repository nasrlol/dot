#!/usr/bin/env python3
"""Write window-rules.kdl: an open-on-workspace rule for every installed app,
chosen by its .desktop Categories using workspaces.ini (see that file)."""

import configparser
import os
import re
import shlex
import sys
from pathlib import Path

here = Path(__file__).resolve().parent
out = here / "window-rules.kdl"

data_home = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
data_dirs = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
# Earlier dirs win, as in the XDG spec: a user entry shadows the system one.
app_dirs = [data_home / "applications"] + [Path(d) / "applications" for d in data_dirs]


def read_ini():
    ini = configparser.ConfigParser(delimiters=("=",), comment_prefixes=("#",),
                                    inline_comment_prefixes=None, interpolation=None)
    ini.optionxform = str  # keep category/app names case-sensitive
    ini.read(here / "workspaces.ini")
    categories = list(ini["categories"].items()) if "categories" in ini else []
    apps = {}
    for app, value in (ini["apps"].items() if "apps" in ini else []):
        workspace, *extra = value.split(None, 1)
        matches = []
        for m in re.finditer(r"(app-id|title)=(.*?)(?=\s+(?:app-id|title)=|$)", extra[0] if extra else ""):
            matches.append((m.group(1), m.group(2).strip()))
        apps[app] = (workspace, matches)
    return categories, apps


def desktop_entries():
    seen = {}
    for d in app_dirs:
        for f in sorted(d.glob("*.desktop")) if d.is_dir() else []:
            seen.setdefault(f.stem, f)
    for name, f in sorted(seen.items()):
        entry = {}
        in_main = False
        for line in f.read_text(errors="replace").splitlines():
            if line.startswith("["):
                in_main = line.strip() == "[Desktop Entry]"
            elif in_main and "=" in line:
                k, v = line.split("=", 1)
                entry.setdefault(k.strip(), v.strip())
        yield name, entry


def app_ids(name, entry):
    """Names the app's window is likely to report as its app-id."""
    ids = [name]
    if entry.get("StartupWMClass"):
        ids.append(entry["StartupWMClass"])
    try:
        argv = shlex.split(entry.get("Exec", ""))
    except ValueError:
        argv = []
    # Look through "env VAR=x prog"; "sh -c ..." hides the program, so skip it.
    if argv and Path(argv[0]).name == "env":
        argv = [a for a in argv[1:] if not a.startswith("-") and "=" not in a]
    if argv and Path(argv[0]).name not in ("sh", "bash", "flatpak"):
        ids.append(Path(argv[0]).name)
    unique = {}
    for i in ids:  # matched case-insensitively, so dedupe that way too
        unique.setdefault(i.lower(), i.lower())
    return list(unique)


def main():
    categories, overrides = read_ini()
    rules = {}  # workspace -> [(comment, kind, regex)]
    skipped = []

    for name, entry in desktop_entries():
        if entry.get("Type", "Application") != "Application":
            continue
        override = overrides.get(name)
        if override is None and (entry.get("NoDisplay") == "true" or entry.get("Hidden") == "true"
                                 or entry.get("Terminal") == "true"):
            continue
        cats = [c for c in entry.get("Categories", "").split(";") if c]
        if "ConsoleOnly" in cats and override is None:
            continue

        if override:
            workspace, extra = override
        else:
            workspace = next((ws for cat, ws in categories if cat in cats), None)
            extra = []
        if workspace is None or workspace == "none":
            if workspace is None:
                skipped.append(name)
            continue

        label = entry.get("Name", name)
        ids = "|".join(re.sub(r"([.+*?()\[\]{}^$|\\])", r"\\\1", i) for i in app_ids(name, entry))
        matches = rules.setdefault(workspace, [])
        if not any(kind == "title" for kind, _ in extra):
            matches.append((label, "app-id", f"(?i)^({ids})$"))
        for kind, regex in extra:
            matches.append((label, kind, regex))

    lines = ["// Generated by gen-window-rules from workspaces.ini. Do not edit."]
    for workspace in sorted(rules):
        lines += ["", "window-rule {"]
        for label, kind, regex in rules[workspace]:
            lines.append(f"    match {kind}=r#\"{regex}\"#  // {label}")
        lines += [f"    open-on-workspace \"{workspace}\"", "}"]
    text = "\n".join(lines) + "\n"

    if not out.exists() or out.read_text() != text:
        out.write_text(text)  # only touch it on change: niri reloads on write
        print(f"wrote {out}")
    if skipped:
        print("no workspace (no matching category):", ", ".join(skipped), file=sys.stderr)


if __name__ == "__main__":
    main()
