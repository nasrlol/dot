input {
    keyboard {

        repeat-delay 150
        repeat-rate 50

        xkb {
            options "ctrl:nocaps"
        }
    }

    touchpad {
        dwt
        natural-scroll
        tap
        click-method "clickfinger"
    }

    mouse {
         off
    }

    trackpoint {
        accel-profile "flat"
    }

    // Mod+N on the current workspace jumps back to the previous one.
    workspace-auto-back-and-forth
}

gestures {
    hot-corners {
        off
    }
}

// Alt+Tab window switcher (default binds). Previews are bigger than the
// defaults (max-height 480, max-scale 0.5).
recent-windows {
    previews {
        max-height 1200
        max-scale 1.0
    }
}

blur {
    passes 3
    offset 2.0
}


// niri owns scaling: each output gets its own scale and apps follow it
// (Firefox devPixelsPerPx -1 via firefox/link, no QT_SCALE_FACTOR).
// Externals stay at 1; below 1 niri downsamples (blurry text).
output "eDP-1" {
    mode "2560x1664@60.000"
    scale 1.0
    transform "normal"
    position x=0 y=0
}

output "Samsung Electric Company U28E570 H4LN904216" {
    mode "2560x1440@59.951"
    scale 1
    focus-at-startup
    transform "normal"
    position x=1707 y=0
}

output "Iiyama North America PL2470H 0x000001E2" {
    mode "1920x1080@143.998"
    scale 1
    position x=1707 y=0
}

output "Philips Consumer Electronics Company PHL 273V7 UHB1751015164" {
    mode "1920x1080@60.000"
    scale 0.8
    position x=1707 y=0
}

layout {
    gaps 20

    center-focused-column "never"
    preset-column-widths {

        proportion 0.1
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0

    }
    default-column-width { proportion 0.5; }

    focus-ring {
        off

        width 0

    }

    border {
        on
        width 4
    }

    shadow {
        draw-behind-window false
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {
        // left 64
        // right 64
        // top 64
        // bottom 64
    }
}

environment {
    XDG_CURRENT_DESKTOP "niri"
    // same agent and D-Bus sockets fish/OpenRC use, so GUI apps and shells share one bus
    SSH_AUTH_SOCK "/run/user/1000/ssh-agent.socket"
    DBUS_SESSION_BUS_ADDRESS "unix:path=/run/user/1000/bus"
}

spawn-at-startup "dbus-update-activation-environment" "WAYLAND_DISPLAY" "DISPLAY" "XDG_CURRENT_DESKTOP" "QT_QPA_PLATFORM" "XCURSOR_THEME" "XCURSOR_SIZE" "DBUS_SESSION_BUS_ADDRESS" "XDG_RUNTIME_DIR"
spawn-at-startup "gentoo-pipewire-launcher"
// waybar/fonts.conf keeps the bar's emoji monochrome (Noto Emoji).
spawn-at-startup "sh" "-c" "FONTCONFIG_FILE=~/.config/waybar/fonts.conf exec waybar"
// Wallpaper, scaled to cover every output (crops instead of letterboxing)
spawn-at-startup "sh" "-c" "exec swaybg --mode fill --image ~/xp.jpg"
// Also draw it behind the overview and workspace gaps, not just the desktop
layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}
// Emacs server in the session env (Wayland, ssh-agent); Mod+E attaches to it.
spawn-at-startup "emacs" "--fg-daemon"
// Resident Ghostty (gtk-single-instance) so Mod+Return opens windows instantly.
spawn-at-startup "ghostty" "--initial-window=false"
spawn-at-startup "sh" "-c" "~/.config/niri/gen-window-rules"
// Lan Mouse daemon (no GUI); peers and fingerprints live in ~/.config/lan-mouse/config.toml.
spawn-at-startup "sh" "-c" "exec ~/.local/bin/lan-mouse daemon"
// Lock after 5 min idle, power off displays after 6 min, lock before sleep.
// swaylock/lock draws the background (quote, contributions, open windows).
// (the swayidle command lives in idle.sh so the power menu can toggle it)
spawn-at-startup "~/.config/waybar/scripts/idle.sh" "start"

// Lock on lid close; suspend via sudo unless ~/.local/bin/stay-awake has a live pid registered.
switch-events {
    lid-close { spawn "sh" "-c" "~/.config/niri/lid-close"; }
}

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd
// The panel is 60Hz, so smoothness comes from spreading motion over more
// frames: softer springs (lower stiffness = longer glide) and damping 1.0
// (critically damped: no overshoot or end-of-motion wobble). Window
// open/close use a long-tail deceleration curve instead of a short cubic.
// Movement that follows the user's input (workspace switch, scrolling the
// view) stays a bit stiffer than the rest so it doesn't feel laggy.
animations {
    slowdown 1.0

    workspace-switch {
        spring damping-ratio=1.0 stiffness=300 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=300 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=260 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=260 epsilon=0.0001
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=260 epsilon=0.0001
    }
    window-open {
        duration-ms 260
        curve "cubic-bezier" 0.05 0.7 0.1 1.0
    }
    window-close {
        duration-ms 200
        curve "cubic-bezier" 0.3 0.0 0.8 0.15
    }
}
window-rule {
    match app-id=r#"^firefox(-bin)?$"# title="^Picture-in-Picture$"
    match app-id=r#"chromium$"# title="^Picture-in-Picture$"
    open-floating true
}


// Declared first so it is workspace 1: Emacs opens here (see workspaces.ini).
workspace "edit"

workspace "dev" {
    open-on-output "Iiyama North America PL2470H 0x000001E2"
}

// Web lands on the external when it is plugged in, the laptop otherwise.
workspace "web" {
    open-on-output "Philips Consumer Electronics Company PHL 273V7 UHB1751015164"
}
workspace "media"

// Which workspace each app opens on, by its .desktop category. Edit
// workspaces.ini, not window-rules.kdl (gen-window-rules writes it).
include "window-rules.kdl"

// 4coder opens on "dev" (rule above); without this niri opens it there in the
// background when you're on another workspace. Focusing it switches to dev.
window-rule {
    match app-id=r#"(?i)^(4coder|4ed)$"#
    open-focused true
}

// Emacs opens on "edit"; follow it there instead of opening in the background.
window-rule {
    match app-id=r#"(?i)^(emacs|emacsclient)$"#
    open-focused true
}

// Terminals open floating on the current workspace; fullscreen one with
// Mod+Shift+F when you want it big.
window-rule {
    match app-id=r#"(?i)^(com\.mitchellh\.ghostty|ghostty|alacritty|foot|footclient|kitty)$"#
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.6; }
}

// gdbs program-output window (gdb/.config/gdb/gdbinit): keep focus on gdb
window-rule {
    match app-id=r#"^gdb-io$"#
    open-focused false
}

window-rule {
    tiled-state true

    background-effect {

    }

}


binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return hotkey-overlay-title="ghostty"   { spawn "ghostty" "+new-window"; }
    Mod+Shift+Return hotkey-overlay-title="claude" { spawn "ghostty" "+new-window" "--working-directory=/home/nasr/dev" "-e" "/home/nasr/.local/bin/claude"; }
    Mod+P hotkey-overlay-title="fuzzel"    { spawn "fuzzel"; }
    Mod+Semicolon hotkey-overlay-title="window jump" { spawn "/home/nasr/.local/bin/niri-window-jump"; }
    Mod+Space hotkey-overlay-title="palette" { spawn "/home/nasr/.local/bin/palette"; }
    Mod+E hotkey-overlay-title="emacs"     { spawn "emacsclient" "-c" "-a" ""; }
    Mod+B hotkey-overlay-title="firefox"  { spawn "firefox-bin";  }
    Mod+N hotkey-overlay-title="4coder"    { spawn "/opt/4coder/build/4ed";       }
    Mod+Shift+N hotkey-overlay-title="4coder + raddbg project" { spawn "/home/nasr/.local/bin/4ed-open"; }
    Mod+G hotkey-overlay-title="halloy"    { spawn "/home/nasr/.local/share/cargo/bin/halloy"; }
    Mod+D hotkey-overlay-title="raddbg in project" { spawn "/home/nasr/.local/bin/raddbg-open"; }
    Mod+Shift+D hotkey-overlay-title="raddbg"    { spawn "/opt/raddbg/raddbg"; }
    Mod+T hotkey-overlay-title="pop top todo" { spawn "/home/nasr/.config/waybar/scripts/todo.py" "pop"; }
    Mod+Ctrl+T hotkey-overlay-title="undo todo pop" { spawn "/home/nasr/.config/waybar/scripts/todo.py" "unpop"; }
    Mod+Shift+T hotkey-overlay-title="Toggle light/dark theme" { spawn "/home/nasr/dotfiles/theme/switch"; }

    Mod+O repeat=false { toggle-overview; }
    XF86LaunchA repeat=false { toggle-overview; }
    XF86LaunchB hotkey-overlay-title=null { spawn "fuzzel"; }
    XF86Search hotkey-overlay-title=null { spawn "fuzzel"; }

    Mod+Q repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Backslash       { focus-monitor-next; }
    Mod+Shift+Backslash { move-column-to-monitor-next; }
    Mod+Ctrl+Backslash  { move-workspace-to-monitor-next; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    Mod+M { maximize-window-to-edges; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+Shift+S { screenshot; }

    // Apple keyboard media / brightness keys
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute         allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioPlay         allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext         allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev         allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "-d" "apple-panel-bl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "-d" "apple-panel-bl" "set" "5%-"; }
    XF86KbdBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "-d" "kbd_backlight" "set" "10%+"; }
    XF86KbdBrightnessDown allow-when-locked=true { spawn "brightnessctl" "-d" "kbd_backlight" "set" "10%-"; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Alt+L hotkey-overlay-title="Lock the screen" { spawn "sh" "-c" "~/.config/swaylock/lock"; }
    Mod+Shift+M hotkey-overlay-title="Toggle touchpad" { spawn "/home/nasr/.local/bin/niri-toggle-touchpad"; }
}

cursor {

    xcursor-theme "Bibata-Original-Ice"
    xcursor-size 35
    hide-when-typing
    // hide-after-inactive-ms 1000
}

// Colors come from theme/palette-{dark,light} via colors.kdl.tmpl (run theme/gen).
include "colors.kdl"
