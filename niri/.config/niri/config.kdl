input {
    keyboard {

        repeat-delay 150
        repeat-rate 50

        xkb {
            options "ctrl:nocaps"
        }
    }

    touchpad {
        dwt
        natural-scroll
        tap
        click-method "clickfinger"
    }

    trackpoint {
        accel-profile "flat"
    }

    // Mod+N on the current workspace jumps back to the previous one.
    workspace-auto-back-and-forth
}

gestures {
    hot-corners {
        off
    }
}

// Alt+Tab window switcher (default binds).
recent-windows {
}

blur {

    passes 3
    offset 3.0
}


layout {
    gaps 16

    center-focused-column "never"
    preset-column-widths {

        proportion 0.1
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0

    }
    default-column-width { proportion 0.5; }

    focus-ring {
        off

        width 0

    }

    border {
        on
        width 4
    }

    shadow {
        draw-behind-window false
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {
        // left 64
        // right 64
        // top 64
        // bottom 64
    }
}

environment {
    XDG_CURRENT_DESKTOP "niri"
    // same agent socket fish uses, so GUI apps (emacs/magit) can push over ssh
    SSH_AUTH_SOCK "/run/user/1000/ssh-agent.socket"
}

// Hand the session env to D-Bus so activated services (portals, dconf) see it.
spawn-at-startup "dbus-update-activation-environment" "WAYLAND_DISPLAY" "DISPLAY" "XDG_CURRENT_DESKTOP" "QT_SCALE_FACTOR" "XCURSOR_THEME" "XCURSOR_SIZE"
// waybar/fonts.conf keeps the bar's emoji monochrome (Noto Emoji).
spawn-at-startup "sh" "-c" "FONTCONFIG_FILE=~/.config/waybar/fonts.conf exec waybar"
// Emacs server in the session env (Wayland, ssh-agent); Mod+E attaches to it.
spawn-at-startup "emacs" "--fg-daemon"
// Resident Ghostty (gtk-single-instance) so Mod+Return opens windows instantly.
spawn-at-startup "ghostty" "--initial-window=false"
spawn-at-startup "sh" "-c" "~/.config/niri/gen-window-rules"
// Idle locking is per host (hosts/<host>.kdl).

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd
animations {
    // For no animations at all (instant switching), uncomment:
    // off
    slowdown 1.0

    // Gentle ease-out instead of stiff springs: slower start-to-finish, and
    // most of the motion happens early so the screen settles calmly.
    // Instant workspace switching; other animations stay on.
    workspace-switch {
        off
    }
    horizontal-view-movement {
        duration-ms 320
        curve "ease-out-cubic"
    }
    window-movement {
        duration-ms 280
        curve "ease-out-cubic"
    }
    window-resize {
        duration-ms 280
        curve "ease-out-cubic"
    }
    overview-open-close {
        duration-ms 320
        curve "ease-out-cubic"
    }
    window-open {
        duration-ms 220
        curve "cubic-bezier" 0.05 0.7 0.1 1.0
    }
    window-close {
        duration-ms 160
        curve "ease-out-quad"
    }
}
window-rule {
    match app-id=r#"firefox$"#  title="^Picture-in-Picture$"
    match app-id=r#"chromium$"# title="^Picture-in-Picture$"
    open-floating true
}

// Named workspaces, in order: Mod+1 dev, Mod+2 web, Mod+3 term, Mod+4 media

workspace "dev" {
    open-on-output "Iiyama North America PL2470H 0x000001E2"
}

workspace "debugger"
workspace "term"
workspace "web"
workspace "media"

// Which workspace each app opens on, by its .desktop category. Edit
// workspaces.ini, not window-rules.kdl (gen-window-rules writes it).
include "window-rules.kdl"

// gdbs program-output window (gdb/.config/gdb/gdbinit): keep focus on gdb
window-rule {
    match app-id=r#"^gdb-io$"#
    open-focused false
}

window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
    tiled-state true

    background-effect {

    }

}


binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return hotkey-overlay-title=" ghostty"   { spawn "ghostty";   }
    Mod+P hotkey-overlay-title="      wofi"      { spawn-sh "cd ~/.config/wofi && exec wofi --show drun"; }
    Mod+E hotkey-overlay-title="      emacs"     { spawn "emacsclient" "-c" "-a" ""; }
    Mod+B hotkey-overlay-title="      firefox"  { spawn "firefox";      }
    Mod+N hotkey-overlay-title="      4coder"    { spawn "/opt/4coder/build/4ed";       }
    Mod+G hotkey-overlay-title="      halloy"    { spawn "/home/nasr/.local/share/cargo/bin/halloy"; }
    Mod+D hotkey-overlay-title="      gf2"       { spawn "/home/nasr/.local/bin/gf2"; }
    Mod+Shift+T hotkey-overlay-title="Toggle light/dark theme" { spawn "/home/nasr/dotfiles/theme/switch"; }

    Mod+O repeat=false { toggle-overview; }
    F3 repeat=false { toggle-overview; }
    F4 hotkey-overlay-title="wofi" { spawn-sh "cd ~/.config/wofi && exec wofi --show drun"; }
    XF86LaunchA repeat=false { toggle-overview; }
    XF86LaunchB hotkey-overlay-title=null { spawn-sh "cd ~/.config/wofi && exec wofi --show drun"; }
    XF86Search hotkey-overlay-title=null { spawn-sh "cd ~/.config/wofi && exec wofi --show drun"; }

    Mod+Q repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Backslash       { focus-monitor-next; }
    Mod+Shift+Backslash { move-column-to-monitor-next; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    Mod+M { maximize-window-to-edges; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+Shift+S { screenshot; }

    // Apple keyboard media / brightness keys
    // pactl works on both PipeWire (pipewire-pulse) and plain PulseAudio
    XF86AudioRaiseVolume  allow-when-locked=true { spawn-sh "~/.config/waybar/scripts/volume.py up"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn-sh "~/.config/waybar/scripts/volume.py down"; }
    XF86AudioMute         allow-when-locked=true { spawn-sh "~/.config/waybar/scripts/volume.py mute"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "pactl" "set-source-mute" "@DEFAULT_SOURCE@" "toggle"; }
    XF86AudioPlay         allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext         allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev         allow-when-locked=true { spawn "playerctl" "previous"; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Alt+L hotkey-overlay-title="Lock the screen" { spawn "sh" "-c" "~/.config/swaylock/lock"; }
}

cursor {

    xcursor-theme "Bibata-Original-Ice"
    xcursor-size 35
    hide-when-typing
    // hide-after-inactive-ms 1000
}

// Colors come from theme/palette-{dark,light} via colors.kdl.tmpl (run theme/gen).
include "colors.kdl"

// Per-machine settings (outputs, scaling, audio launcher, hardware keys).
// host.kdl links to hosts/<host>.kdl and is created by ./install;
// local.kdl is never committed.
include optional=true "host.kdl"
include optional=true "local.kdl"
