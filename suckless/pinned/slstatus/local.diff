@@ -139,3 +139,20 @@
 
 	return (n == EOF) ? -1 : n;
 }
+
+int
+lscanf(FILE *fp, const char *key, const char *fmt, void *res)
+{
+		int n;
+		char line[256];
+
+		n = -1;
+		while (fgets(line, sizeof(line), fp))
+			if (strncmp(line, key, strlen(key)) == 0) {
+				n = sscanf(line + strlen(key), fmt, res);
+				break;
+			}
+
+		rewind(fp);
+		return (n == 1) ? 1 : -1;
+}
